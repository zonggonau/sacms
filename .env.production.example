# ─────────────────────────────────────────────────────────────────────────────
# SaCMS — Production Environment Configuration for Docker & VPS
# Brand: SaCMS (Smart Content Management System)
# Host: 164.68.116.79 | Domain: https://developer.sacms.cloud (apex sacms.cloud = SaCMS nocode di Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Node & App Core ───
NODE_ENV="production"
PORT=3000
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
NEXTAUTH_URL="https://developer.sacms.cloud"
NEXT_PUBLIC_APP_URL="https://developer.sacms.cloud"
PUBLIC_GATEWAY_IP="164.68.116.79"
PUBLIC_CNAME_TARGET="cname.sacms.cloud"

# ─── Database Configuration (Docker PostgreSQL 17 Internal) ───
# Inside Docker network, the hostname is 'postgres'
POSTGRES_USER="sacms"
POSTGRES_PASSWORD="CHANGE_TO_STRONG_PASSWORD"
POSTGRES_DB="sacms"
DATABASE_URL="postgresql://sacms:CHANGE_TO_STRONG_PASSWORD@postgres:5432/sacms?schema=public"
DIRECT_URL="postgresql://sacms:CHANGE_TO_STRONG_PASSWORD@postgres:5432/sacms?schema=public"

# ─── Redis Caching & Rate Limiting (Docker Redis 7 Internal) ───
REDIS_URL="redis://redis:6379"

# ─── Self-Hosted & License ───
SELFHOST_MODE="true"
LICENSE_KEY=""
LICENSE_SERVER_URL="https://license.sacms.cloud"

# ─── Automated Cron Jobs Secret ───
CRON_SECRET="GENERATE_RANDOM_CRON_SECRET_HERE"

# ─── Email Delivery (Resend & SMTP Fallback) ───
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_API_KEY"
RESEND_FROM="SaCMS <noreply@mail.sacms.cloud>"
# SMTP Fallback (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SaCMS <noreply@mail.sacms.cloud>"

# ─── Midtrans Payment Gateway (QRIS, VA, Cards) ───
MIDTRANS_SERVER_KEY="REPLACE_WITH_YOUR_MIDTRANS_SERVER_KEY"
MIDTRANS_CLIENT_KEY="REPLACE_WITH_YOUR_MIDTRANS_CLIENT_KEY"
MIDTRANS_MODE="sandbox" # Set to 'production' for live payments
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="REPLACE_WITH_YOUR_MIDTRANS_CLIENT_KEY"
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# ─── Workspace Media Object Storage (MinIO on the SaCMS VPS) ───
# docker compose profiles: "storage" runs MinIO, "cron" runs scheduled jobs (needs CRON_SECRET)
COMPOSE_PROFILES="storage,cron"
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
# App access key, created by the minio-init service
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="sacms-media"
S3_REGION="us-east-1"
S3_PUBLIC_URL="https://media.sacms.cloud/sacms-media"

# ─── Cloudflare R2 (platform assets: support attachments, avatars) ───
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── Offsite database backup copy (optional) ───
# Daily pg_dump backups (docker-compose.yml's db-backup service) are local
# to this VPS by default — lost together with it if the disk/server is
# ever lost. Set these to also upload each dump to an S3-compatible bucket
# (R2, S3, Backblaze B2, ...). Deliberately a SEPARATE bucket from
# R2_BUCKET_NAME above: that media bucket is served publicly via Caddy
# (media.sacms.cloud) — database dumps must never land somewhere
# public-readable. Leave BACKUP_S3_BUCKET empty to keep backups local-only.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION="auto"

# ─── AI Engine & Edge Builder ───
# IMPORTANT: this key was previously committed with a real, live value here.
# If you have not already rotated it in Super Admin Settings / Setting["systemApiKey"],
# do that FIRST before deploying — the old value must be treated as compromised.
NEXT_PUBLIC_SYSTEM_API_KEY="REPLACE_WITH_YOUR_SYSTEM_API_KEY"
DEEPSEEK_API_KEY="REPLACE_WITH_YOUR_DEEPSEEK_API_KEY"
VERCEL_ACCESS_TOKEN="REPLACE_WITH_YOUR_VERCEL_ACCESS_TOKEN"
V0_API_KEY="REPLACE_WITH_YOUR_V0_API_KEY"

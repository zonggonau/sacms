# Copy this file to .env.local and fill in the values from your SaCMS workspace.

# Base URL of the SaCMS server (no trailing slash).
SACMS_BASE_URL="http://localhost:3000"

# Workspace slug, as shown in the dashboard URL.
SACMS_TENANT="demo"

# Read token from Developer & API → API Tokens. Read scope is enough for this
# starter. Keep it server-side only; it is never sent to the browser.
SACMS_API_TOKEN=""

# Locale used for content queries.
SACMS_DEFAULT_LOCALE="id"

# Shared secret for the webhook at /api/revalidate. Must match the secret set
# on the SaCMS webhook. Leave empty to disable the webhook endpoint.
SACMS_WEBHOOK_SECRET=""

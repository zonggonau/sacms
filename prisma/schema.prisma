generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String?
  password            String?
  image               String?
  role                String          @default("owner")
  ownerSlug           String?         @unique
  emailVerified       DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  plan                String          @default("free")
  // Lifetime flag, set once and never cleared — true the first time ANY
  // workspace this user owns is created on (or switched back to) the Free
  // workspace plan. Deliberately NOT derived from "does the user currently
  // own a tenant with plan=free", since upgrading or deleting that
  // workspace would silently reset the allowance. One free workspace per
  // account, ever — see createTenantAction and subscription/cancel/route.ts.
  freeWorkspaceUsed   Boolean         @default(false)
  aiCreditsUsed       Int             @default(0)
  aiCreditsExtra      Int             @default(0)
  masterDatabaseUrl   String?
  masterStorageConfig Json?
  accounts            Account[]
  sessions            Session[]
  subscriptions       Subscription[]
  tenants             TenantMember[]
  ownedTenants        Tenant[]        @relation("OwnerTenants")
  aiQuotaLedgers      AiQuotaLedger[]
  supportTickets      SupportTicket[]
  proposalsAssigned   Proposal[]      @relation("ProposalAssignee")
  proposalsCreated    Proposal[]      @relation("ProposalCreator")
  proposalActivities  ProposalActivity[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                              String                        @id @default(cuid())
  name                            String
  slug                            String                        @unique
  description                     String?
  logo                            String?
  plan                            String                        @default("free")
  status                          String                        @default("active")
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  ownerId                         String?
  owner                           User?                         @relation("OwnerTenants", fields: [ownerId], references: [id], onDelete: SetNull)
  brandLogo                       String?
  brandName                       String?
  customDomain                    String?                       @unique
  customDomainStatus              String?
  customDomainVerifiedAt          DateTime?
  customEmailSender               String?
  databaseUrl                     String?
  licenseKey                      String?                       @unique
  faviconUrl                      String?
  primaryColor                    String?
  storageConfig                   Json?
  hostingStatus                   String?                       @default("trial")
  hostingExpiresAt                DateTime?
  vercelProjectId                 String?
  vercelDeploymentUrl             String?
  aiTokensUsed                    Int                           @default(0)
  aiCreditsExtra                  Int                           @default(0)
  /// No longer read: storage add-ons live in StorageAddon and expire monthly.
  storageExtraBytes               BigInt                        @default(0)
  apiCallsExtra                   Int                           @default(0)
  // Headless member auth policy
  allowMemberRegistration         Boolean                       @default(true)
  requireMemberEmailVerification  Boolean                       @default(false)
  /// Exact origins allowed to call the credential-issuing auth endpoints with CORS.
  /// Empty = fall back to the tenant's own domains (+ localhost in dev).
  allowedAuthOrigins              String[]                      @default([])
  /// Where the member email-verification link should point (the developer's own
  /// frontend). The one-time code is appended as `?code=<token>`. Empty = use the
  /// SaCMS-hosted fallback confirmation page.
  memberEmailConfirmationRedirect String?
  /// Where the member password-reset link should point. `?code=<token>` is
  /// appended. Empty = SaCMS-hosted fallback reset page.
  memberPasswordResetRedirect     String?
  /// Draft/final toggle for the tenant's CMS schema (null = draft/editable,
  /// set = finalized/locked). Only enforced on dashboard-facing schema
  /// mutations — see src/lib/schema-lock.ts for why MCP bypasses this.
  schemaFinalizedAt               DateTime?
  /// Whether this workspace inherits its owner's "Infrastruktur Sendiri"
  /// (BYODB/BYOS, set at /dashboard/infrastructure) — see
  /// getOwnerMasterInfra() in src/lib/database.ts. Default true preserves
  /// automatic inheritance; an owner can flip individual workspaces to
  /// false to keep them on SaCMS's dedicated DB / Enterprise storage pool.
  useOwnerInfra                   Boolean                       @default(true)
  apiKeys                         ApiKey[]
  apiRequests                     ApiRequest[]
  apiTokens                       ApiToken[]
  auditLogs                       AuditLog[]
  components                      Component[]
  contentEntries                  ContentEntry[]
  contentTypes                    ContentType[]
  contentTypeGroups               ContentTypeGroup[]
  media                           Media[]
  mediaFolders                    MediaFolder[]
  settings                        Setting[]
  singleTypes                     SingleType[]
  subscriptions                   Subscription[]
  componentAssignments            TenantComponentAssignment[]
  contentTypeAssignments          TenantContentTypeAssignment[]
  locales                         TenantLocale[]
  members                         TenantMember[]
  singleTypeAssignments           TenantSingleTypeAssignment[]
  webhooks                        Webhook[]
  aiQuotaLedgers                  AiQuotaLedger[]
  customDomains                   CustomDomain[]
  oauthClients                    OAuthClient[]
  oauthCodes                      OAuthCode[]
  oauthTokens                     OAuthToken[]
  supportTickets                  SupportTicket[]
  storageAddons                   StorageAddon[]
  enterpriseStorageAllocation     EnterpriseStorageAllocation?
  appMembers                      Member[]
  memberRoles                     MemberRole[]

  @@map("tenants")
}

model TenantMember {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  role              String   @default("subscriber")
  joinedAt          DateTime @default(now())
  customPermissions Json?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model CustomPlanOverride {
  id                String   @id @default(cuid())
  userId            String?  @unique
  tenantId          String?  @unique
  maxWorkspaces     Int?
  maxContentTypes   Int?
  maxContentEntries Int?
  maxTeamMembers    Int?
  maxStorage        Int?
  maxLocales        Int?
  maxApiCalls       Int?
  maxAiTokens       Int?
  maxAiCredits      Int?
  maxCustomDomains  Int?
  note              String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("custom_plan_overrides")
}

model ContentType {
  id              String                        @id @default(cuid())
  name            String
  slug            String
  description     String?
  isPublished     Boolean                       @default(false)
  showInCms       Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  tenantId        String?
  docxTemplateUrl String?
  // Tags this row as a Global-workspace draft materialization of a
  // SchemaTemplate being authored/edited — not a real production content
  // type. Plain tag, no FK (cleanup is explicit in the template delete
  // route), kept out of the normal list actions via `draftTemplateId: null`.
  draftTemplateId String?
  // Optional sidebar grouping — see ContentTypeGroup. groupOrder positions
  // this content type among siblings sharing the same groupId (ignored
  // while groupId is null; ungrouped items keep their existing
  // `updatedAt desc` ordering instead).
  groupId         String?
  groupOrder      Int                           @default(0)
  entries         ContentEntry[]
  schemaFields    SchemaField[]
  tenant          Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group           ContentTypeGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tenants         TenantContentTypeAssignment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([draftTemplateId])
  @@index([groupId])
  @@map("content_types")
}

/// A named, optionally-nested (up to 3 levels, enforced in
/// src/actions/content-type-groups.ts) folder for organizing a tenant's
/// Content Types in the CMS sidebar — e.g. a group "Artikel" containing the
/// "Artikel" and "Kategori Artikel" content types. Deleting a group cascades
/// to its child groups, but only orphans (SetNull) any ContentType.groupId
/// that pointed to it — content types themselves are never deleted.
model ContentTypeGroup {
  id           String             @id @default(cuid())
  tenantId     String
  name         String
  parentId     String?
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       ContentTypeGroup?  @relation("ContentTypeGroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     ContentTypeGroup[] @relation("ContentTypeGroupHierarchy")
  contentTypes ContentType[]

  @@index([tenantId])
  @@index([parentId])
  @@map("content_type_groups")
}

model SchemaField {
  id           String  @id @default(cuid())
  name         String
  slug         String
  type         String
  required     Boolean @default(false)
  unique       Boolean @default(false)
  order        Int     @default(0)
  jsonPath     String?
  localizable  Boolean @default(true)
  relationSlug String?
  options      Json?

  // Polymorphic relations
  contentTypeId String?
  contentType   ContentType? @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  singleTypeId String?
  singleType   SingleType? @relation(fields: [singleTypeId], references: [id], onDelete: Cascade)

  componentId String?
  component   Component? @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, slug])
  @@unique([singleTypeId, slug])
  @@unique([componentId, slug])
  @@map("schema_fields")
}

model AiQuotaLedger {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  tokens    Int      @default(0)
  credits   Int      @default(0)
  words     Int      @default(0)
  model     String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("ai_quota_ledgers")
}

model TenantContentTypeAssignment {
  id            String      @id @default(cuid())
  tenantId      String?
  contentTypeId String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contentTypeId])
  @@map("tenant_content_type_assignments")
}

model ContentEntry {
  id                String                    @id @default(cuid())
  contentTypeId     String
  tenantId          String?
  publishedAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  deletedAt         DateTime?
  locale            String                    @default("id")
  reviewComment     String?
  scheduledAt       DateTime?
  status            ContentStatus             @default(DRAFT)
  searchVector      Unsupported("tsvector")?
  data              Json
  documentId        String?
  contentType       ContentType               @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  tenant            Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewAssignments ContentReviewAssignment[]
  versions          ContentVersion[]

  @@index([documentId])
  @@index([tenantId, contentTypeId, status])
  @@index([tenantId, locale])
  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@index([tenantId, contentTypeId, deletedAt])
  @@index([deletedAt])
  @@map("content_entries")
}

model ContentVersion {
  id             String       @id @default(cuid())
  contentEntryId String
  version        Int
  publishedAt    DateTime?
  changeType     String
  changedBy      String?
  changeSummary  String?
  createdAt      DateTime     @default(now())
  data           Json
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, version])
  @@index([contentEntryId, createdAt])
  @@map("content_versions")
}

model ContentReviewAssignment {
  id             String       @id @default(cuid())
  contentEntryId String
  reviewerId     String
  reviewerName   String?
  order          Int          @default(0)
  status         String       @default("pending")
  comment        String?
  reviewedAt     DateTime?
  assignedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, reviewerId])
  @@index([reviewerId, status])
  @@map("content_review_assignments")
}

model SingleType {
  id              String                       @id @default(cuid())
  name            String
  slug            String
  description     String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  isPublished     Boolean                      @default(false)
  showInCms       Boolean                      @default(true)
  tenantId        String?
  // See ContentType.draftTemplateId — same draft-tag convention.
  draftTemplateId String?
  schemaFields    SchemaField[]
  tenant          Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants         TenantSingleTypeAssignment[]

  @@unique([tenantId, slug])
  @@index([draftTemplateId])
  @@map("single_types")
}

model TenantSingleTypeAssignment {
  id           String     @id @default(cuid())
  tenantId     String?
  singleTypeId String
  enabled      Boolean    @default(true)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  locale       String     @default("id")
  data         Json?
  singleType   SingleType @relation(fields: [singleTypeId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, singleTypeId, locale])
  @@map("tenant_single_type_assignments")
}

model Component {
  id              String                      @id @default(cuid())
  name            String
  slug            String
  description     String?
  category        String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenantId        String?
  // See ContentType.draftTemplateId — same draft-tag convention.
  draftTemplateId String?
  schemaFields    SchemaField[]
  tenant          Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants         TenantComponentAssignment[]

  @@unique([tenantId, slug])
  @@index([draftTemplateId])
  @@map("components")
}

model TenantComponentAssignment {
  id          String    @id @default(cuid())
  tenantId    String?
  componentId String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, componentId])
  @@map("tenant_component_assignments")
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  key         String    @unique
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  permissions Json?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  tenantId               String?
  plan                   String
  status                 String               @default("active")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  midtransCustomerId     String?
  midtransSubscriptionId String?
  invoices               Invoice[]
  paymentTransactions    PaymentTransaction[]
  tenant                 Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  amount            Float
  currency          String       @default("IDR")
  status            String       @default("pending")
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  midtransInvoiceId String?
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  subscriptionId  String?
  invoiceId       String?
  orderId         String        @unique
  paymentType     String?
  paymentMethod   String?
  amount          Float
  status          String
  transactionId   String?
  transactionTime DateTime?
  fraudStatus     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rawResponse     Json?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payment_transactions")
}

// ── Pricing (platform-level, not tenant content) ──────────────────────────
//
// Previously modeled as CMS Content Entries under the "SaCMS Global" tenant
// (sacms-account-pricing / sacms-workspace-pricing / sacms-ai-pricing /
// sacms-addons content types) — at least 4 independent, hand-written
// readers existed across the codebase (getDynamicWorkspacePrices/
// getDynamicAccountPrices in midtrans.ts, plus separate direct ContentEntry
// queries in checkout, subscriptions/plans, tenant-plan.ts, public/plans,
// the account dashboard/billing pages, and public-api.ts's landing-page
// aggregator — which additionally fell back to a THIRD, hardcoded copy in
// default-landing-page.ts when the CMS entries were empty). None of them
// agreed on the fallback/parsing rule, so admin edits could silently not
// reach every consumer. These four tables are the single, type-safe source
// of truth each kind of pricing needed — one table per kind rather than one
// wide table with a category discriminator, since their real field sets
// are mostly disjoint (an AI credit pack has no `maxTeamMembers`, an addon
// has no `credits`), not variations of one shape.
//
// Landing-page content (hero, FAQ, testimonials, etc.) stays as regular CMS
// content under the Global tenant — unaffected, and correctly CMS-shaped.

model AccountPlan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  price         Float
  yearlyPrice   Float?
  maxWorkspaces Int
  features      Json?
  isPopular     Boolean  @default(false)
  ctaText       String?
  ctaHref       String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("account_plans")
}

model WorkspacePlan {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?
  price              Float
  yearlyPrice        Float?
  maxContentTypes    Int
  maxContentEntries  Int
  maxTeamMembers     Int
  maxStorageMb       Int
  maxLocales         Int
  maxApiCalls        Int
  // Informational fair-use figure for shared-hosting plans — not literally
  // metered (see the equivalent field's comment in the old CMS seed data);
  // the quota actually enforced is maxApiCalls.
  fairUseBandwidthGb Int?
  features           Json?
  isActive           Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("workspace_plans")
}

model AiCreditPack {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  credits     Int
  priceUsd    Float
  price       Float
  badge       String?
  features    Json?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_credit_packs")
}

model Addon {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  icon          String?
  price         Float?
  priceLabel    String?
  unit          String?
  featureKey    String?
  // Top-up-specific fields (e.g. storage tiers) — null for a plain
  // feature-flag addon that doesn't grant a metered quota.
  checkoutAlias String?
  yearlyPrice   Float?
  isTopup       Boolean  @default(false)
  quotaType     String?
  amountUnits   BigInt?
  billingPeriod String?
  features      Json?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("addons")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  data      Json?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The tenant audit-log page and the cron retention job both filter/sort
  // on exactly this pair — without it, both degrade to a full scan + sort
  // over a table shared by every tenant as it grows.
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model SystemMetric {
  id        String   @id @default(cuid())
  type      String
  value     Float
  timestamp DateTime @default(now())
  metadata  Json?

  @@map("system_metrics")
}

model ApiRequest {
  id         String   @id @default(cuid())
  tenantId   String?
  endpoint   String
  method     String
  statusCode Int
  duration   Int
  apiKeyId   String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_requests")
}

model MediaFolder {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  path      String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  media     Media[]
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderHierarchy")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@map("media_folders")
}

model Media {
  id           String       @id @default(cuid())
  tenantId     String
  folderId     String?
  name         String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  alt          String?
  caption      String?
  width        Int?
  height       Int?
  uploadedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  mediumUrl    String?
  storageKey   String?
  /// Bytes of the generated thumbnail and medium versions; counts toward the storage quota with `size`.
  variantBytes Int          @default(0)
  metadata     Json?
  isPrivate    Boolean      @default(false)
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, mimeType])
  @@map("media")
}

model ApiToken {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  token       String    @unique
  type        String    @default("read-only")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  permissions Json?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

// Platform-wide schema template catalog, authored in the SaCMS Global
// workspace and browsable by every tenant. No tenantId FK — this is
// catalog data gated by role checks (access.isGlobal) in the API routes,
// not relational tenant ownership, and must stay visible even to tenants
// on a dedicated database (see getTenantDb() — this model is only ever
// queried through the plain shared `db` client).
model SchemaTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  icon        String   @default("📦")
  description String?
  schema      Json
  published   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("schema_templates")
}

model Webhook {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  url             String
  secret          String?
  enabled         Boolean             @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  hookType        String              @default("async")
  events          Json
  headers         Json?
  deadLetters     WebhookDeadLetter[]
  logs            WebhookLog[]
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean
  duration   Int?
  error      String?
  createdAt  DateTime @default(now())
  payload    Json
  response   Json?
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model WebhookDeadLetter {
  id          String    @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  lastError   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRetryAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([webhookId])
  @@map("webhook_dead_letters")
}

model TenantLocale {
  id        String  @id @default(cuid())
  tenantId  String?
  locale    String
  name      String
  isDefault Boolean @default(false)
  isEnabled Boolean @default(true)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locale])
  @@map("tenant_locales")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

// ─── Enterprise Self-Hosting ────────────────────────────────────────────

model EnterpriseLicense {
  id              String              @id @default(cuid())
  licenseKey      String              @unique
  customerName    String
  customerEmail   String?
  customerPhone   String?
  organization    String?
  type            String              @default("enterprise") // enterprise | partner | trial
  features        Json? // ["self-host", "unlimited-workspaces", ...]
  /// Pooled storage grant (GB) for an ACCOUNT-level license (shared across
  /// every workspace the license holder owns — see isEnterpriseTenant(userId)
  /// usage in plan-enforcement.ts). Null for licenses that don't grant pooled
  /// storage (e.g. a self-hosted instance-wide license, which stays fully
  /// unmetered via a separate mechanism). Admin-editable here independent of
  /// the signed key itself — see validateLicense()'s dbRecord override.
  storageGb       Int?
  /// AI credit grant for the license's validity period (account-level only,
  /// same bypass as storageGb — see enforceUserAiCredits() in
  /// plan-enforcement.ts). Bounded, not unlimited: once used up, the holder
  /// renews/upgrades rather than getting free unlimited AI generation.
  aiCredits       Int?
  /// Workspace-count entitlement for an ACCOUNT-level license (bounded, like
  /// storageGb/aiCredits above) — see getUserWorkspaceLicense() in
  /// plan-enforcement.ts. null = this license grants no workspace
  /// entitlement at all (falls back to the account's normal plan limit); a
  /// specific number = hard cap enforced at that count; 999999 is the
  /// reserved "Unlimited" sentinel already used elsewhere in this codebase
  /// for "practically unbounded".
  maxWorkspaces   Int?
  /// Contract value in IDR for this license (admin-entered at generation,
  /// editable after) — purely a sales/record-keeping field, never consulted
  /// by validateLicense()/enforcement. Printed on the generated contract PDF.
  priceIdr        Int?
  /// How many distinct accounts may hold this license at once — enforced by
  /// POST /api/user/license/activate via the LicenseActivation rows below.
  /// Defaults to 1, i.e. "one license, one account": the first account to
  /// activate the key binds it, and every other account is rejected until
  /// an admin raises this (or an activation row is removed).
  maxInstances    Int                 @default(1)
  activations     LicenseActivation[]
  issuedAt        DateTime            @default(now())
  expiresAt       DateTime
  lastValidatedAt DateTime?
  validatedCount  Int                 @default(0)
  status          String              @default("active") // active | expired | revoked
  metadata        Json?
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([licenseKey, status])
  @@index([expiresAt])
  @@map("enterprise_licenses")
}

/// One row per account that has ever activated a given license — see
/// maxInstances above. Lets POST /api/user/license/activate tell "the same
/// account re-activating" (fine) apart from "a different account trying to
/// use an already-bound key" (rejected once the count hits maxInstances).
model LicenseActivation {
  id          String            @id @default(cuid())
  licenseId   String
  license     EnterpriseLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  userId      String
  userEmail   String?
  activatedAt DateTime          @default(now())

  @@unique([licenseId, userId])
  @@index([licenseId])
  @@map("license_activations")
}

/// Owner's explicit slice of their own pooled EnterpriseLicense.storageGb
/// grant, assigned to one specific owned workspace — see
/// getOwnerStorageAllocationPlan() in plan-enforcement.ts. One row per
/// tenant that has been EXPLICITLY assigned a figure; a tenant with no row
/// here gets an equal share of the pool's remainder, computed live on every
/// read — there is no "auto" row/sentinel stored anywhere, so creating or
/// deleting a workspace, or changing another workspace's allocation, is
/// reflected immediately with no backfill/migration step.
model EnterpriseStorageAllocation {
  id          String   @id @default(cuid())
  ownerId     String
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Always > 0 — to hand a workspace back to the auto-split pool, delete
  /// this row rather than writing 0.
  allocatedGb Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("enterprise_storage_allocations")
}

model LicenseCache {
  id              String   @id @default("local-license")
  licenseKey      String
  customerName    String
  customerEmail   String?
  type            String
  features        Json?
  /// Cached copy of EnterpriseLicense.storageGb (or the signed payload's
  /// value when no local EnterpriseLicense row exists) — see license.ts.
  storageGb       Int?
  /// Cached copy of EnterpriseLicense.aiCredits — see license.ts.
  aiCredits       Int?
  /// Cached copy of EnterpriseLicense.maxWorkspaces — see license.ts.
  maxWorkspaces   Int?
  issuedAt        DateTime
  expiresAt       DateTime
  lastValidatedAt DateTime
  status          String
  updatedAt       DateTime @updatedAt

  @@map("license_cache")
}

model CustomDomain {
  id         String    @id @default(cuid())
  tenantId   String
  domain     String    @unique
  status     String    @default("pending") // pending, verified, failed
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  target     String    @default("cms") // cms | workspace | site | api
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("custom_domains")
}

// ─── OAuth 2.0 ─────────────────────────────────────────────────────────

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String?
  name         String
  redirectUris String[]
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_clients")
}

model OAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  tenantId            String
  redirectUri         String?
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_codes")
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String?  @unique
  clientId     String
  tenantId     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("oauth_tokens")
}

// ─── RBAC & Permissions ──────────────────────────────────────────────

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  displayName     String
  description     String?
  category        String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  tenantId     String?
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, tenantId])
  @@index([tenantId])
  @@index([roleId])
  @@map("role_permissions")
}

/// Storage bought on top of a workspace's plan quota, valid for one month (lib/billing/storage-addon.ts).
model StorageAddon {
  id               String    @id @default(cuid())
  tenantId         String
  bytes            BigInt
  /// Payment order that bought it; unique so a payment is never granted twice.
  orderId          String    @unique
  startsAt         DateTime  @default(now())
  expiresAt        DateTime
  /// The add-on this purchase continues: it starts when that one expires.
  renewsAddonId    String?   @unique
  reminder7dSentAt DateTime?
  reminder1dSentAt DateTime?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("storage_addons")
}

// ─── Customer Support & IT Helpdesk ───────────────────────────────────

model SupportTicket {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  subject   String
  category  String   @default("general") // general | billing | technical | infrastructure | domain
  priority  String   @default("normal") // low | normal | high | urgent
  status    String   @default("open") // open | in_progress | resolved | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([tenantId, status])
  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String
  senderRole  String   @default("user") // user | admin | system
  message     String   @db.Text
  attachments Json? // Array of file metadata or URLs
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ─── Sales Pipeline: Penawaran (institutional proposals/offers) ────

model Proposal {
  id              String    @id @default(cuid())
  institutionName String
  /// Free text, not a fixed enum — "UMKM", "Sekolah", "Pemerintah",
  /// "Perusahaan", or anything else the sales staff types.
  institutionType String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  /// Pipeline stage — see PROPOSAL_STAGES in src/lib/proposal-stages.ts.
  stage           String    @default("draft") // draft | sent | negotiation | won | lost
  estimatedValueIdr Int?
  notes           String?   @db.Text
  lostReason      String?
  /// Short, sellable feature list shown as the offer item's description on
  /// the proposal PDF (e.g. "Pendaftaran Online, Rekam Medis Digital, ...").
  /// Staff-editable; optionally AI-suggested based on institutionName/Type
  /// via POST /api/admin/proposals/suggest-features. Falls back to a plain
  /// generic description when unset.
  featuresText    String?   @db.Text
  /// Live preview URL of a demo website the SaCMS team already built for
  /// this prospect (e.g. a Vercel preview deployment, before any custom
  /// domain) — embedded as a QR code on the generated proposal PDF so the
  /// prospect can scan it and see the actual site. Only for sites SaCMS
  /// itself built; the underlying workspace is handed over to the
  /// prospect's own account once the deal closes.
  demoUrl         String?
  assignedToId    String?
  createdById     String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedTo User?              @relation("ProposalAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities ProposalActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@map("proposals")
}

model ProposalActivity {
  id         String   @id @default(cuid())
  proposalId String
  authorId   String?
  /// "note" | "status_change" | "call" | "email" | "meeting"
  type       String
  message    String?  @db.Text
  fromStage  String?
  toStage    String?
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@map("proposal_activities")
}

// ─── Multi-Tenant End-User Members & Headless Auth ──────────────────

model Member {
  id                   String          @id @default(cuid())
  tenantId             String
  email                String
  passwordHash         String
  name                 String?
  avatar               String?
  role                 String          @default("authenticated") // slug of MemberRole (public | authenticated | custom slugs)
  status               String          @default("active") // active | suspended | pending_verification
  emailVerified        DateTime?
  metadata             Json? // Custom attributes (e.g. phone, address, preferences)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastLoginAt          DateTime?
  passwordResetToken   String?         @unique
  passwordResetExpires DateTime?
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions             MemberSession[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("members")
}

model MemberSession {
  id           String    @id @default(cuid())
  memberId     String
  tenantId     String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([tenantId])
  @@map("member_sessions")
}

// ─── Strapi-parity: Users & Permissions Plugin (MemberRole) ─────────

/// A role scoped to a single tenant (e.g. "Public", "Authenticated", "VIP Member")
model MemberRole {
  id          String                 @id @default(cuid())
  tenantId    String
  name        String // Human label e.g. "VIP Member"
  slug        String // Identifier e.g. "vip-member"
  description String?
  isSystem    Boolean                @default(false) // true = public | authenticated (cannot delete)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions MemberRolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("member_roles")
}

/// Granular permission granted to a MemberRole for a content-type and action
/// action: find | findOne | create | update | delete
model MemberRolePermission {
  id              String     @id @default(cuid())
  memberRoleId    String
  contentTypeSlug String // slug of ContentType, or "*" = all
  action          String // find | findOne | create | update | delete
  granted         Boolean    @default(true)
  conditions      Json? // Optional: field-level or ownership conditions
  createdAt       DateTime   @default(now())
  memberRole      MemberRole @relation(fields: [memberRoleId], references: [id], onDelete: Cascade)

  @@unique([memberRoleId, contentTypeSlug, action])
  @@index([memberRoleId])
  @@map("member_role_permissions")
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# License RSA public key is a verification key, not a secret — it must ship
# in the Docker image (see Dockerfile) or parseLicenseKey() ENOENTs in every
# deployed container. license-private.pem stays ignored; never add it here.
!keys/license-public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log
# Skills directory
/skills/

# public
/public/keys/

# prisma generated (regenerated by `prisma generate` locally and in CI)
/prisma/generated-client/
/prisma/generated-client-new/
/prisma/generated-client-old/
/prisma/query_engine-*.node
public/upload/

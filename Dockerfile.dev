FROM oven/bun:1.3-alpine

WORKDIR /app

# Install build tools, git, and OpenSSL for Prisma engine on Linux
RUN apk add --no-cache libc6-compat openssl git curl wget

COPY package.json bun.lock* ./
RUN bun install

COPY prisma ./prisma/
RUN bunx prisma generate

COPY . .

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development

CMD ["bun", "run", "dev", "--port", "3000", "--hostname", "0.0.0.0"]

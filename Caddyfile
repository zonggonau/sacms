# ─────────────────────────────────────────────────────────────────────────────
# SaCMS Caddy Configuration — Reverse Proxy, On-Demand SSL & Custom Domain Routing
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@sacms.cloud

	# On-Demand TLS: Auto-issue SSL certificates for verified tenant custom domains
	# Caddy asks SaCMS before issuing any certificate for an unknown hostname.
	on_demand_tls {
		ask http://127.0.0.1:3000/api/public/caddy-ask
		interval 2m
		burst 5
	}
}

# Main SaCMS Domain & Core Subdomains (Automatic Let's Encrypt HTTPS & HTTP→HTTPS Redirect)
sacms.cloud, www.sacms.cloud, admin.sacms.cloud, cms.sacms.cloud, api.sacms.cloud, *.sacms.cloud {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Direct IP fallback for port 80 HTTP (health checks, internal)
http://164.68.116.79, http://localhost {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# ── On-Demand TLS for ALL Tenant Custom Domains & Subdomains ─────────────────
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# HTTP fallback for port 80 (redirects to HTTPS or handles non-TLS traffic)
:80 {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# Internal debug port (unchanged)
:81 {
	@transform_port_query {
		query XTransformPort=*
	}

	handle @transform_port_query {
		reverse_proxy 127.0.0.1:{query.XTransformPort}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}


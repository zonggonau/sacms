# ─────────────────────────────────────────────────────────────────────────────
# SaCMS Caddy Configuration — Reverse Proxy & Automatic SSL / HTTPS Edge
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@sacms.cloud
}

# Main SaCMS Domain (Automatic Let's Encrypt HTTPS & HTTP->HTTPS Redirect)
sacms.cloud, www.sacms.cloud {
	reverse_proxy app:3000
}

# Direct IP fallback for port 80 HTTP
http://164.68.116.79, http://localhost {
	reverse_proxy app:3000
}

# Fallback for all other tenant subdomains / custom domains
:80 {
	reverse_proxy app:3000
}

:81 {
	@transform_port_query {
		query XTransformPort=*
	}

	handle @transform_port_query {
		reverse_proxy app:{query.XTransformPort}
	}

	handle {
		reverse_proxy app:3000
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# SaCMS Caddy Configuration — Reverse Proxy, On-Demand SSL & Custom Domain Routing
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@sacms.cloud

	# On-Demand TLS: Auto-issue SSL certificates for verified tenant custom domains
	# Caddy asks SaCMS before issuing any certificate for an unknown hostname.
	on_demand_tls {
		ask http://127.0.0.1:3000/api/public/caddy-ask
	}
}

# Main SaCMS Domain & Core Subdomains (Automatic Let's Encrypt HTTPS via HTTP-01)
# The apex sacms.cloud (+ www) is the main SaCMS entry point; developer.sacms.cloud
# is kept as an alias.
developer.sacms.cloud, admin.sacms.cloud, cms.sacms.cloud, api.sacms.cloud, sacms.cloud, www.sacms.cloud {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Direct IP fallback for port 80 HTTP (health checks, internal)
http://164.68.116.79, http://localhost {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# Workspace media in MinIO (docker compose profile "storage"), public read:
# https://media.sacms.cloud/sacms-media/<tenantId>/...
media.sacms.cloud {
	reverse_proxy 127.0.0.1:9000
}

# ── Non-SaCMS projects sharing this server ───────────────────────────────────
# These are standalone apps deployed directly on this VPS, outside SaCMS's own
# tenant/custom-domain system — NOT customer workspaces, so they must be listed
# here explicitly (with their own automatic HTTPS) or they fall into the
# generic `https://`/`:80` catch-all below and get silently proxied to the
# SaCMS app instead (what broke mikaday.store after a SaCMS deploy overwrote
# this file with no block for it — see docker container "sacms-nocode-app",
# host port 3005).
mikaday.store, www.mikaday.store {
	reverse_proxy 127.0.0.1:3005
}

# Roundcube webmail (docker container "roundcube", host port 8085) — same
# "missing block gets swallowed by the catch-all" issue as mikaday.store above.
webmail.sacms.cloud {
	reverse_proxy 127.0.0.1:8085
}

# ── On-Demand TLS for ALL Tenant Custom Domains & Subdomains ─────────────────
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# HTTP fallback for port 80 (redirects to HTTPS or handles non-TLS traffic)
:80 {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}


# ─────────────────────────────────────────────────────────────────────────────
# SaCMS Caddy Configuration — Reverse Proxy, On-Demand SSL & Custom Domain Routing
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@sacms.cloud

	# On-Demand TLS: Auto-issue SSL certificates for verified tenant custom domains
	# Caddy asks SaCMS before issuing any certificate for an unknown hostname.
	on_demand_tls {
		ask http://app:3000/api/public/caddy-ask
		interval 2m
		burst 5
	}
}

# Main SaCMS Domain (Automatic Let's Encrypt HTTPS & HTTP→HTTPS Redirect)
sacms.cloud, www.sacms.cloud {
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Direct IP fallback for port 80 HTTP (health checks, internal)
http://164.68.116.79, http://localhost {
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# ── On-Demand TLS for ALL Tenant Custom Domains & Subdomains ─────────────────
# This block automatically handles:
#   - admin.domainuser.go.id      → routes to /dashboard/{tenant}/cms
#   - portal.domainuser.com       → routes to /dashboard/{tenant}
#   - domainuser.com              → routes to /site/{tenant}
#   - api.domainuser.com          → routes to /api/public/{tenant}
# Caddy will only issue SSL if /api/public/caddy-ask returns 200.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# HTTP fallback for port 80 (redirects to HTTPS or handles non-TLS traffic)
:80 {
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# Internal debug port (unchanged)
:81 {
	@transform_port_query {
		query XTransformPort=*
	}

	handle @transform_port_query {
		reverse_proxy app:{query.XTransformPort}
	}

	handle {
		reverse_proxy app:3000
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# SaCMS Caddy Configuration — Reverse Proxy, On-Demand SSL & Custom Domain Routing
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@sacms.cloud

	# On-Demand TLS: Auto-issue SSL certificates for verified tenant custom domains
	# Caddy asks SaCMS before issuing any certificate for an unknown hostname.
	on_demand_tls {
		ask http://127.0.0.1:3000/api/public/caddy-ask
	}
}

# Main SaCMS Domain & Core Subdomains (Automatic Let's Encrypt HTTPS via HTTP-01)
# developer.sacms.cloud is the SaCMS entry point. The apex sacms.cloud (+ www) now
# belongs to SaCMS nocode on Vercel; they stay listed here only until the apex DNS
# record is moved to Vercel. After that cutover no traffic reaches this block for
# them and both hostnames should be removed.
developer.sacms.cloud, admin.sacms.cloud, cms.sacms.cloud, api.sacms.cloud, sacms.cloud, www.sacms.cloud {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Direct IP fallback for port 80 HTTP (health checks, internal)
http://164.68.116.79, http://localhost {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

# Workspace media in MinIO (docker compose profile "storage"), public read:
# https://media.sacms.cloud/sacms-media/<tenantId>/...
media.sacms.cloud {
	reverse_proxy 127.0.0.1:9000
}

# ── On-Demand TLS for ALL Tenant Custom Domains & Subdomains ─────────────────
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# HTTP fallback for port 80 (redirects to HTTPS or handles non-TLS traffic)
:80 {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
	}
}

